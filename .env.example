# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_ALLOWED_DEV_ORIGIN=
DEPLOY_TARGET=vercel
STATIC_ASSET_ORIGIN=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-32-character-minimum-random-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/naichangmoo
NEXT_PUBLIC_AUTH_ENABLED=false

# Salt for hashing client IPs used by public-form rate limiting. Falls back to
# BETTER_AUTH_SECRET when unset; set a dedicated value in production.
RATE_LIMIT_SALT=

# Enable Google now only after credentials exist. LINE and Facebook are configuration-gated.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Cloudflare R2 (private buckets only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Pilot queue. Do not expose in the browser.
REDIS_URL=

# Future billing. Webhook verification is required before any entitlement mutation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
